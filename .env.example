# ==============================================================================
# Samaura Healthcare - Environment Configuration
# ==============================================================================

# Database: SQLite / LibSQL (Turso compatible)
# --- Option 1: Local SQLite file (default for development/VPS) ---
# DATABASE_URL="file:data/samaura.db"
# DATABASE_AUTH_TOKEN=""
#
# --- Option 2: Cloud Turso (serverless / edge-ready) ---
# DATABASE_URL="libsql://your-database-name.turso.io"
# DATABASE_AUTH_TOKEN="your-turso-auth-token"
DATABASE_URL="file:data/samaura.db"
DATABASE_AUTH_TOKEN=""

# Seed Credentials (used by npm run db:seed)
SEED_ADMIN_EMAIL="admin@samaura.com"
SEED_ADMIN_PASSWORD="Admin@123456"

# Auth.js / NextAuth
# Generate a secret via: openssl rand -base64 32
AUTH_SECRET="change-this-to-a-secure-random-string-at-least-32-chars"
AUTH_TRUST_HOST="true"
NEXTAUTH_SECRET="change-this-to-a-secure-random-string-at-least-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# Payments: Provider Configuration
# Options: "razorpay" | "mock" | "" (default: none - online hidden, COD only)
# In development: use "mock" for the hosted sandbox payment simulator.
# In production: set to "razorpay" once KYC is approved and keys are configured.
PAYMENT_PROVIDER=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Email: Resend
RESEND_API_KEY="re_test_placeholder"
EMAIL_FROM="Samaura Healthcare <orders@samaura.com>"
ADMIN_NOTIFICATION_EMAIL="admin@samaura.com"

# Public configuration
NEXT_PUBLIC_SITE_URL="https://www.samaurahealthcare.com"
NEXT_PUBLIC_WHATSAPP_NUMBER=""
NEXT_PUBLIC_BRAND_NAME="Samaura Healthcare"

# Storage Provider (local or cloudinary)
STORAGE_PROVIDER="local"
UPLOAD_DIR="./public/uploads"
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""
