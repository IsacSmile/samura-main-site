{
  "name": "samaura",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "check-claims": "tsx scripts/check-claims.ts",
    "check-claims:db": "tsx scripts/check-claims-db.ts",
    "check": "tsx scripts/check-claims.ts && npm run lint && tsc --noEmit",
    "build": "tsx scripts/check-claims.ts && next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/db/seed/index.ts",
    "db:backup": "tsx scripts/db-backup.ts",
    "db:backup:turso": "tsx scripts/turso-backup.ts",
    "db:remove-samples": "tsx scripts/db-remove-samples.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.5",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^1.52.0",
    "next": "16.3.8",
    "next-auth": "^5.0.0-beta.32",
    "razorpay": "^2.9.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.32.0",
    "sanitize-html": "^2.17.5",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
